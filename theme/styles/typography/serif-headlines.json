{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Serif headlines",
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|valley-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.75"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|hedvig-letters-serif",
					"fontWeight": "400",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.15"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var:preset|font-family|valley-sans",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|hedvig-letters-serif",
					"fontWeight": "400"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|hedvig-letters-serif",
					"fontWeight": "400"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|hedvig-letters-serif"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|hedvig-letters-serif"
				}
			}
		}
	}
}
