{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Graphite",
	"description": "A cool dark design with a sky-blue accent. Dark sections stay dark rather than flipping to white.",
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#111315"
				},
				{
					"name": "Base Two",
					"slug": "base-2",
					"color": "#1b1e21"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#f3f4f6"
				},
				{
					"name": "Contrast Two",
					"slug": "contrast-2",
					"color": "#a1a7b0"
				},
				{
					"name": "Contrast Three",
					"slug": "contrast-3",
					"color": "#3a3f45"
				},
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#93c5fd"
				},
				{
					"name": "Primary Tint",
					"slug": "primary-tint",
					"color": "#1e3a5f"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/code": {
				"color": {
					"background": "var:preset|color|base-2",
					"text": "var:preset|color|contrast"
				}
			},
			"core/column": {
				"variations": {
					"card": {
						"color": {
							"background": "var:preset|color|base-2"
						}
					},
					"dark": {
						"color": {
							"background": "var:preset|color|base-2",
							"text": "var:preset|color|contrast"
						}
					},
					"elevated": {
						"color": {
							"background": "var:preset|color|base-2"
						}
					}
				}
			},
			"core/columns": {
				"variations": {
					"card": {
						"color": {
							"background": "var:preset|color|base-2"
						}
					},
					"dark": {
						"color": {
							"background": "var:preset|color|base-2",
							"text": "var:preset|color|contrast"
						}
					},
					"elevated": {
						"color": {
							"background": "var:preset|color|base-2"
						}
					}
				}
			},
			"core/group": {
				"variations": {
					"card": {
						"color": {
							"background": "var:preset|color|base-2"
						}
					},
					"elevated": {
						"color": {
							"background": "var:preset|color|base-2"
						}
					},
					"dark": {
						"color": {
							"background": "var:preset|color|base-2",
							"text": "var:preset|color|contrast"
						},
						"elements": {
							"button": {
								"color": {
									"background": "var:preset|color|primary",
									"text": "var:preset|color|base"
								},
								":hover": {
									"color": {
										"background": "var:preset|color|contrast",
										"text": "var:preset|color|base"
									}
								}
							},
							"heading": {
								"color": {
									"text": "var:preset|color|contrast"
								}
							},
							"link": {
								"color": {
									"text": "var:preset|color|primary"
								}
							}
						}
					}
				}
			}
		}
	}
}
